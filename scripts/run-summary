#!/usr/bin/env bash
# Usage: run-summary <task> <outcome.json> <factory-dir> <factory-sha> <base-sha> [<execution-file>]
# Run from the target repo. Prints the agent's part of a run's job summary
# (docs/factory-design.md §11): which version of each skill ran and, for the
# implementer <task>, the ticket class and the unrelated issues noticed, from
# its outcome file. <base-sha> is the commit whose skills the agent loaded.
# The skills come from the Skill tool calls in <execution-file> when it is
# readable, flagging an implementer outcome file that lists others; otherwise
# from that outcome file's own list, labelled as such. A missing outcome file,
# or one that isn't a JSON object, still gets the transcript's skills;
# read-outcome judges the file.
set -euo pipefail
task="$1" file="$2" factory="$3" sha="$4" base_sha="$5" execution="${6:-}"
here="$(cd "$(dirname "$0")" && pwd)"
case "$task" in
  implementer|review) ;;
  *) echo "Unknown task '$task': implementer or review." >&2; exit 2 ;;
esac
if [ "$task" = "implementer" ] && [ -f "$file" ] && jq -e 'type == "object"' "$file" > /dev/null 2>&1; then
  outcome="$file"
else
  outcome=""
fi

# The skills as the Skill tool named them: `factory:<name>` for a factory
# skill, the bare name for a target repo's own. The task skills themselves
# aren't steps. The agent's own list holds bare names for whichever ran.
# Only the implementer's outcome file carries one.
reported="$([ -z "$outcome" ] || jq -r '.skills // [] | arrays | .[] | strings' "$outcome")"
if [ -n "$execution" ] && called="$("$here/transcript-skills" "$execution" 2>/dev/null)"; then
  source="transcript"
  called="$(grep -vxE 'factory:(implementer|review)' <<< "$called" || true)"
elif [ -n "$outcome" ]; then
  source="agent"
  called="$reported"
else
  source="none"
  called=""
fi
bare() { sed 's/^factory://' <<< "$1"; }

ticket_class() {
  local class label
  class="$(jq -r '.class // empty' "$outcome")"
  case "$class" in
    none) label="none (fits no class)" ;;
    "") label="not recorded" ;;
    *)
      label="$(grep -v '^#' "$here/implementer/ticket-classes" | awk -F'\t' -v c="$class" '$1 == c { print $2 }')"
      label="${label:-\`$class\` (unknown)}"
      ;;
  esac
  if [ "$(jq -r '.new_concept // false' "$outcome")" = "true" ]; then
    label="$label, with a new or renamed concept"
    if ! bare "$called" | grep -qx domain-modeling; then
      label="$label (but \`domain-modeling\` wasn't called)"
    fi
  fi
  echo "- **Ticket class:** $label"
}

# upstream <skill-dir>: ", upstream <source> <version>" from the skill's
# metadata.upstream front matter, or nothing.
upstream() {
  awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { exit }
    fm && /^  upstream:/ { up = 1; next }
    fm && up && !/^    / { up = 0 }
    up && $1 == "source:" { src = $2 }
    up && $1 == "version:" { ver = $2; gsub(/"/, "", ver) }
    END { if (src && ver) printf ", upstream %s %s", src, ver }
  ' "$1/SKILL.md"
}

# A target-repo skill with the exact name replaces the factory skill, so the
# override is whatever the run started from: the skill at <base-sha>.
override() { git rev-parse --verify --quiet "$base_sha:.claude/skills/$1/SKILL.md"; }

# describe <called-name>: one line saying which version of the skill ran.
describe() {
  local called="$1" name blob version="" factory_line
  name="$(bare "$called")"
  if ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "  - \`$called\`: not a skill name"
    return
  fi
  blob="$(override "$name" || true)"
  if [ -f "$factory/skills/$name/SKILL.md" ]; then version="$(upstream "$factory/skills/$name")"; fi
  factory_line="factory (\`factory:$name\` at ${sha:0:7}$version)"
  if [ "$called" != "$name" ]; then
    # Called as factory:<name>: the factory skill ran, whatever the repo has.
    if [ -n "$blob" ]; then
      echo "  - \`$name\`: $factory_line, but the target repo's override \`.claude/skills/$name/SKILL.md\` was skipped"
    else
      echo "  - \`$name\`: $factory_line"
    fi
  elif [ -n "$blob" ]; then
    echo "  - \`$name\`: target repo override (\`.claude/skills/$name/SKILL.md\`, blob ${blob:0:7})"
  elif [ "$source" = "agent" ] && [ -f "$factory/skills/$name/SKILL.md" ]; then
    # The agent's list uses bare names, so a bare name may be the factory's.
    echo "  - \`$name\`: $factory_line"
  else
    echo "  - \`$name\`: neither a target repo skill nor a factory skill"
  fi
}

skills_run() {
  local heading listed
  if [ "$source" = "none" ]; then
    echo "- **Skills run:** unknown (no transcript)"
    return
  elif [ "$source" = "transcript" ]; then
    heading="- **Skills run** (from the transcript):"
  else
    heading="- **Skills run** (as reported by the agent; no transcript):"
  fi
  if [ -z "$called" ]; then
    echo "$heading none"
  else
    echo "$heading"
    while IFS= read -r name; do describe "$name"; done <<< "$called"
  fi
  if [ "$source" = "transcript" ] && [ -n "$outcome" ] \
     && [ "$(bare "$called" | sort -u)" != "$(sort -u <<< "$reported" | sed '/^$/d')" ]; then
    listed="$(sed '/^$/d; s/.*/`&`/' <<< "$reported" | paste -sd, - | sed 's/,/, /g')"
    echo "- **The agent's own list differs:** it reported ${listed:-nothing}"
  fi
}

# Noticed, not fixed, and kept out of the PR.
unrelated_issues() {
  local unrelated
  unrelated="$(jq -r '.unrelated // [] | arrays | .[] | strings | gsub("[\r\n]+"; " ")' "$outcome")"
  if [ -z "$unrelated" ]; then
    echo "- **Unrelated issues noticed:** none"
  else
    echo "- **Unrelated issues noticed:**"
    while IFS= read -r issue; do echo "  - $issue"; done <<< "$unrelated"
  fi
}

[ -z "$outcome" ] || ticket_class
skills_run
[ -z "$outcome" ] || unrelated_issues
