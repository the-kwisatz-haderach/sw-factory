#!/usr/bin/env bash
# Usage: checks-section <CLAUDE.md>
# Prints CLAUDE.md's `## Checks` section: from its heading up to the next
# `#`/`##` heading, ignoring headings inside code fences. Exits 1 if the file
# or the section is missing.
set -euo pipefail
[ -f "${1:-}" ] || exit 1
awk '
  /^```/ { fenced = !fenced }
  !fenced && /^##?[[:space:]]/ { in_checks = ($0 ~ /^## Checks[[:space:]]*$/); if (in_checks) found = 1 }
  in_checks { print }
  END { exit !found }
' "$1"
